use std::fs;
use std::path::PathBuf;
use crate::core::GameType; // Standardizing to CORE

pub fn apply(game: GameType, path: &PathBuf, percentage: f32) -> Result<String, String> {
    let file_target = "empire.retail.dll";
    let file_backup = "empire.retail.dll.bak";
    let target_path = path.join(file_target);
    let backup_path = path.join(file_backup);

    // Create backup if it doesn't exist
    if !backup_path.exists() {
        fs::copy(&target_path, &backup_path).map_err(|_| "ERROR: Failed to create backup!")?;
    }

    // Read DLL data
    let mut data = fs::read(&target_path).map_err(|_| "ERROR: DLL file not found!")?;

    // Hex Pattern Matching for Cutter Engine
    let (head, body_prefix, tail) = match game {
        GameType::Attila => (
            vec![0x68, 0xA8, 0x34, 0xAC, 0x11, 0x8D, 0x44, 0x24, 0x18], 
            vec![0xC7, 0x44, 0x24, 0x18], 
            vec![0x50, 0x68, 0xC4, 0x35, 0xAC, 0x11]
        ),
        GameType::Rome2 => (
            vec![0x68, 0x68, 0x68, 0x74, 0x11, 0x8D, 0x44, 0x24, 0x18], 
            vec![0xC7, 0x44, 0x24, 0x18], 
            vec![0x50, 0x68, 0xC0, 0x68, 0x74, 0x11]
        ),
        GameType::Britain => (
            vec![0x68, 0x88, 0xA5, 0xC1, 0x11, 0x8D, 0x44, 0x24, 0x18],
            vec![0xC7, 0x44, 0x24, 0x18],
            vec![0x50, 0x68, 0xAC, 0xA6, 0xC1, 0x11]
        ),
    };

    let mut found = false;
    let new_val_bytes = (percentage / 100.0).to_le_bytes();
    let full_pattern_len = head.len() + body_prefix.len() + 4 + tail.len();

    // Scan for engine pattern
    for i in 0..(data.len() - full_pattern_len) {
        if data[i..i+head.len()] == head {
            let body_pos = i + head.len();
            if data[body_pos..body_pos+body_prefix.len()] == body_prefix {
                let val_pos = body_pos + body_prefix.len();
                let tail_pos = val_pos + 4;
                if data[tail_pos..tail_pos+tail.len()] == tail {
                    data[val_pos..val_pos+4].copy_from_slice(&new_val_bytes);
                    found = true;
                    break;
                }
            }
        }
    }

    if found {
        fs::write(&target_path, data).map_err(|_| "ERROR: File is Write Protected!")?;
        Ok(format!("SUCCESS: {:?} Threshold set to {:.0}%", game, percentage))
    } else {
        Err("ERROR: Engine Pattern Not Found!".to_string())
    }
}

pub fn restore(path: &PathBuf) -> Result<String, String> {
    let file_target = "empire.retail.dll";
    let file_backup = "empire.retail.dll.bak";
    let target_path = path.join(file_target);
    let backup_path = path.join(file_backup);

    if backup_path.exists() {
        let _ = fs::remove_file(&target_path);
        fs::rename(&backup_path, &target_path).map_err(|_| "ERROR: Failed to restore original file!")?;
        Ok("RESTORE SUCCESS: Original Engine Restored!".to_string())
    } else {
        Ok("INFO: File is already original state.".to_string())
    }
}